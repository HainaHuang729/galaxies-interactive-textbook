{
  "name": "galaxies-interactive-textbook",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source Chinese interactive textbook of galaxy formation and evolution",
  "license": "MIT",
  "engines": {"node": ">=22"},
  "scripts": {
    "start": "python3 start.py",
