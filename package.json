{
  "name": "galaxies-interactive-textbook",
  "version": "0.1.2",
  "private": true,
  "description": "An open-source Chinese interactive textbook of galaxy formation and evolution",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/python.cjs start.py",
    "build": "node scripts/python.cjs scripts/build-chapters.py",
    "test": "node scripts/check-models.cjs",
    "test:browser": "node scripts/check-glossary-browser.cjs",
    "test:workbench": "node scripts/check-workbench-browser.cjs",
    "test:disk-brush": "node scripts/check-disk-brush.cjs",
    "test:discovery": "node scripts/check-discovery-browser.cjs",
    "test:hr-figure": "node scripts/check-hr-diagram-browser.cjs",
    "check:public": "node scripts/python.cjs scripts/check-public-release.py",
    "release:offline": "node scripts/python.cjs scripts/package-offline.py"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
